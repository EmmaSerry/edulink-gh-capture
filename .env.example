# Copy this file to .env.local and fill in the SAME Supabase project's
# values already used for the edulink-gh-web cloud dashboard (Project
# Settings -> API Keys -> Publishable/anon key). This is one shared
# backend behind two separate front-end apps - not a second database.
# .env.local is gitignored - never commit real keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
